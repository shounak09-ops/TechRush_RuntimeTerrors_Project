# Only needed for a PRODUCTION deploy where the backend (/server) is hosted
# on a different domain/URL than the frontend — e.g. frontend on Vercel,
# backend on Render/Railway/Fly.io.
#
# Leave this unset for local dev — vite.config.js already proxies /api to
# http://localhost:3001, so a relative path works fine there.
#
# Set to your deployed backend's URL, no trailing slash:
VITE_API_URL=https://your-backend-url.example.com

# Reminder: Vite only reads VITE_-prefixed vars, and only bakes them in at
# BUILD time. Set this in your hosting platform's environment variables
# dashboard before/at build time — editing it after the site is built and
# deployed won't do anything until you rebuild.
