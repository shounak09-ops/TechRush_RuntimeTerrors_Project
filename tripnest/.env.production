# Copy this file to .env.production (or set the same variable in your
# hosting platform's dashboard) and fill in your deployed backend's URL.
#
# vite.config.js's dev-server proxy ("/api" -> localhost:3001) only exists
# while running `npm run dev` locally — a production build has no such
# proxy, so aiService.js needs the real, absolute URL of wherever /server
# is deployed (Render, Railway, Fly.io, etc). Vite bakes this in at BUILD
# TIME, not runtime, so you must rebuild/redeploy after setting it.
#
# Use https — if the frontend is served over https and this is http, the
# browser will silently block the request as mixed content.

VITE_API_BASE_URL=https://tech-rush-runtime-terrors-project-r.vercel.app
